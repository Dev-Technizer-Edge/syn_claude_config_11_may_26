{
  "manifest_version": 3,
  "name": "Claude Bulk Delete",
  "version": "1.0.0",
  "description": "Add bulk-delete functionality to claude.ai conversation sidebar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Bulk Delete"
  },
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
